# Database
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/dashmetric?schema=public"

# NextAuth
# NEXTAUTH_URL should be the URL where your app is hosted
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET should be a random string, at least 32 characters
NEXTAUTH_SECRET="generate-a-secure-random-string-here"

# File Upload
# Directory where uploaded files will be stored
UPLOAD_DIR="./uploads"

# Environment
# Set to "production" when deploying
NODE_ENV="development"
